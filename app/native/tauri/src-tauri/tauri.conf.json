{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3.5 Character Codex",
  "version": "1.0.0",
  "identifier": "io.github.charactercodex35",
  "build": {
    "frontendDist": "../../www"
  },
  "app": {
    "windows": [
      {
        "title": "3.5 Character Codex",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "3.5 Character Codex contributors",
    "copyright": "MIT License. Rules text: Open Game License v1.0a.",
    "category": "Game",
    "shortDescription": "3.5 SRD character sheets",
    "longDescription": "Character sheets, spells, combat tracker, notes, maps and rules lookup for the 3.5 System Reference Document.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
